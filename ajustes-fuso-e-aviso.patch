diff --git a/backend/database/connection.js b/backend/database/connection.js
index 779449c..405a1ba 100644
--- a/backend/database/connection.js
+++ b/backend/database/connection.js
@@ -10,4 +10,11 @@ const connection = mysql.createPool({
     database: process.env.DB_NAME
 });
 
+// Horário de Brasília (UTC-3, sem horário de verão).
+// O servidor do Railway roda em UTC; sem isto, CURRENT_TIMESTAMP e o
+// DATE_FORMAT do histórico usariam o horário do servidor.
+connection.pool.on('connection', (conexao) => {
+    conexao.query("SET time_zone = '-03:00'");
+});
+
 export default connection;
